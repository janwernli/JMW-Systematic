# JMW Capital Partners Trading - configuration.
# Copy to .env and edit (deploy/setup.sh does the copy on the VM and sets chmod 600).
# .env is git-ignored: never commit real keys.

# --- Server: localhost only. On the Azure VM the dashboard is reached through `tailscale serve`
# (https://<machine>.<tailnet>.ts.net); the systemd unit always binds 127.0.0.1:8765. ---
APP_HOST=127.0.0.1
APP_PORT=8765
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Storage (relative paths are relative to the repository folder) ---
# DATABASE_PATH=./data/momentum.db

# --- Logging: json | text (text reads best in journalctl) ---
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Market data provider: alpaca | norgate ---
# alpaca  = Alpaca Market Data. Use this on the VM.
# norgate = Norgate Data (Windows only: needs the Norgate Data Updater + `pip install norgatedata`);
#           point-in-time Russell 1000 incl. delisted stocks, for backtests on your PC.
MARKET_DATA_PROVIDER=alpaca
# NORGATE_INDEX=Russell 1000
# NORGATE_HISTORY_START=2000-01-01

# --- Alpaca: PAPER account keys (paper dashboard -> API keys). Used for market data and paper trading.
# Only the paper endpoint is ever used; any other trading host is refused. ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# sip = consolidated volume (free plans get SIP history except the most recent 15 minutes)
ALPACA_DATA_FEED=sip
ALPACA_HISTORY_START=2016-01-01
# Optional: one symbol per line. Without it, the top ALPACA_MAX_SYMBOLS active common stocks by
# RECENT dollar volume are used (flagged in the UI as a survivorship/look-ahead-biased universe).
# ALPACA_UNIVERSE_FILE=./universe.txt
ALPACA_MAX_SYMBOLS=600

# --- SEC EDGAR (sector SIC codes, Alpaca provider only): the SEC requires a name + contact e-mail,
# e.g. "JMW-Systematic research you@example.com". Sent only to sec.gov. ---
SEC_USER_AGENT=

# --- Alpaca PAPER trading automation ---
# Orders are only sent when this is true AND the dashboard's automation switch is on.
# Start with false, check a few dry runs (Trading page), then set true.
# Run the scheduler in ONE place only (the VM or the Windows PC), never both for the same account.
BROKER_TRADING_ENABLED=false
# ALPACA_PAPER_TRADING_URL=https://paper-api.alpaca.markets   (any non-paper host is refused)

# --- Push notifications via ntfy (https://ntfy.sh): a summary after every daily run and an alert on
# errors, stale data or a failed backup. Empty = off. Install the ntfy app and subscribe to the topic.
# Public ntfy.sh topics can be read by anyone who knows the name: use a long random one,
# e.g. jmw-<output of: openssl rand -hex 12>. Messages contain equity and order counts, never keys. ---
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=            (access token, only for a protected topic / your own ntfy server)
