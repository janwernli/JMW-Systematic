# Copy to .env and edit. .env is git-ignored -- never commit real keys.

# --- Server (localhost only by default) ---
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Storage ---
# DATABASE_PATH=./data/momentum.db

# --- Logging: json | text ---
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Market data provider: demo | alpaca ---
# demo   = deterministic synthetic fixture (no key, clearly labelled DEMO)
# alpaca = Alpaca Market Data (free account key; read-only data access, no orders are ever sent)
MARKET_DATA_PROVIDER=demo

# Alpaca (only needed when MARKET_DATA_PROVIDER=alpaca). Keys stay server-side.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# sip = consolidated volume (recommended; free plans get SIP history except the last 15 min)
ALPACA_DATA_FEED=sip
ALPACA_HISTORY_START=2016-01-01
# Optional: one symbol per line. Without it, the top ALPACA_MAX_SYMBOLS active common stocks by
# RECENT dollar volume are used (flagged in the UI as a survivorship/look-ahead-biased universe).
# ALPACA_UNIVERSE_FILE=./universe.txt
ALPACA_MAX_SYMBOLS=600

# Seed the demo dataset, a default backtest and a demo virtual portfolio on first start
DEMO_AUTOSEED=true
